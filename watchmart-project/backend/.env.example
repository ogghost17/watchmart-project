# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=2h

# Comma-separated list of origins allowed to call this API.
# If you open frontend/index.html with VS Code's Live Server, that's
# usually http://127.0.0.1:5500
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
